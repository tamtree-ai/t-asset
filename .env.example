# t-asset settings. Copy to .env.local for development; on Vercel set them in the project settings.

# Postgres. Locally: `pnpm db:up` (port 5434). On Vercel: set by the Neon Marketplace integration.
DATABASE_URL=postgres://tasset:tasset@localhost:5434/tasset

# Public https address of the app, used in share links and the URLs handed to Tamtree.
APP_URL=http://localhost:3000

# 32 bytes for AES-GCM (share tokens, passcodes): openssl rand -hex 32
STUDIO_SECRET=

# The one owner. The hash comes from: pnpm hash-password
OWNER_EMAIL=you@example.com
OWNER_PASSWORD_HASH=
STUDIO_NAME=Your Studio

# Files. On Vercel, connecting a private Blob store sets BLOB_STORE_ID (+ OIDC) and BLOB_READ_WRITE_TOKEN.
# Locally, the default is the local driver: files under .blob-data, served by /api/dev-blob.
# BLOB_DRIVER=local
# BLOB_LOCAL_DIR=.blob-data
# Uploads stop when stored files would pass this (bytes). Vercel Blob Hobby is 1 GB.
# BLOB_SOFT_CAP_BYTES=943718400
# KEEP_VIDEO_ORIGINALS=1

# Tamtree (plan §5.3): the token Tamtree sends to /api/tamtree/*, and where t-asset sends file.uploaded.
TAMTREE_API_TOKEN=
TAMTREE_WEBHOOK_URL=
TAMTREE_WEBHOOK_SECRET=

# Vercel sends this to /api/cron/cleanup.
CRON_SECRET=
